func identity(input x, output y)
{
    y = x;
}

func gaussian3(input x, output y, para w[6])
{
    def z = x * w[4] + w[5];
    y = (w[0] + w[1] * x + w[2] * x * x + w[3] * x * x * x) * exp(-z * z);
}

net parameterized(input x, output y, para w[1])
{
    tensor[2] x;
    tensor[6] w[0];
    tensor[2] y<i> = gaussian3<.>[., j](x<i>, w[0]<j>);
}

print.CPU(parameterized, "./output/tensor_backend_di.cpp");
